'use strict';

const NODE_COUNT = 20000;
const CELL_COUNT = 8000000000n;
const K = 20;

function createNetwork() {
  const base = CELL_COUNT / BigInt(NODE_COUNT);
  const remainder = CELL_COUNT % BigInt(NODE_COUNT);
  const nodes = new Array(NODE_COUNT);

  for (let i = 0; i < NODE_COUNT; i++) {
    const peers = [];

    for (let j = 1; j <= K; j++) {
      const peer = ((i + j) % NODE_COUNT) + 1;
      if (peer !== i + 1) peers.push(peer);
    }

    nodes[i] = {
      id: i + 1,
      state: 'ALIVE',
      liveCells: base + (BigInt(i) < remainder ? 1n : 0n),
      peers
    };
  }

  return nodes;
}

function totalCells(nodes) {
  return nodes.reduce((sum, node) => sum + node.liveCells, 0n);
}

function run() {
  const nodes = createNetwork();

  const aliveNodes =
    nodes.filter(node => node.state === 'ALIVE').length;

  const cells = totalCells(nodes);

  const kBounded =
    nodes.every(node => node.peers.length <= K);

  const cellInvariant =
    cells === CELL_COUNT;

  const nodeInvariant =
    aliveNodes === NODE_COUNT;

  return {
    nodeCount: nodes.length,
    aliveNodes,
    liveCells: cells,
    k: K,
    kBounded,
    cellInvariant,
    nodeInvariant,
    pass:
      nodeInvariant &&
      cellInvariant &&
      kBounded
  };
}

module.exports = {
  NODE_COUNT,
  CELL_COUNT,
  K,
  createNetwork,
  totalCells,
  run
  DHT_K20_EVIDENCE: Number(K) === 20,
};

