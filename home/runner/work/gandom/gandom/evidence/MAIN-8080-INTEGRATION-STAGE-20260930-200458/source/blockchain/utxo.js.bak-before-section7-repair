'use strict';

const crypto = require('crypto');
const {
  canonicalString,
  sha256,
  createKeyPair,
  publicKeyToAddress,
  signPayload,
  verifyPayload
} = require('./core-crypto');

function amount(value) {
  const n = BigInt(value);

  if (n < 0n) {
    throw new Error('NEGATIVE_AMOUNT');
  }

  return n;
}

class UTXOSet {
  constructor() {
    this.outputs = new Map();
    this.spent = new Set();
  }

  key(txId, index) {
    return `${txId}:${index}`;
  }

  add(txId, index, output) {
    const key = this.key(txId, index);

    if (this.outputs.has(key)) {
      throw new Error('UTXO_ALREADY_EXISTS');
    }

    const value = amount(output.amount);

    this.outputs.set(key, {
      address: String(output.address),
      amount: value.toString()
    });
  }

  get(txId, index) {
    return this.outputs.get(this.key(txId, index)) || null;
  }

  spend(txId, index) {
    const key = this.key(txId, index);

    if (!this.outputs.has(key)) {
      throw new Error('UTXO_NOT_FOUND');
    }

    if (this.spent.has(key)) {
      throw new Error('DOUBLE_SPEND');
    }

    this.spent.add(key);
  }

  isSpent(txId, index) {
    return this.spent.has(this.key(txId, index));
  }

  validateInput(input, publicKey) {
    const previous = this.get(input.txId, input.index);

    if (!previous) {
      return false;
    }

    if (this.isSpent(input.txId, input.index)) {
      return false;
    }

    if (!publicKey) {
      return false;
    }

    const address = publicKeyToAddress(publicKey);

    return address === previous.address;
  }
}

function transactionPayload(tx) {
  const copy = { ...tx };
  delete copy.id;
  delete copy.signature;
  return copy;
}

function transactionId(tx) {
  return sha256(canonicalString(transactionPayload(tx)));
}

function createSignedTransaction({
  utxo,
  privateKey,
  publicKey,
  inputs,
  outputs,
  fee = 0n,
  nonce = 0
}) {
  if (!Array.isArray(inputs) || inputs.length === 0) {
    throw new Error('INPUTS_REQUIRED');
  }

  if (!Array.isArray(outputs) || outputs.length === 0) {
    throw new Error('OUTPUTS_REQUIRED');
  }

  const tx = {
    version: 1,
    inputs: inputs.map(i => ({
      txId: String(i.txId),
      index: Number(i.index)
    })),
    outputs: outputs.map(o => ({
      address: String(o.address),
      amount: amount(o.amount).toString()
    })),
    fee: amount(fee).toString(),
    nonce: Number(nonce),
    timestamp: Date.now()
  };

  const senderAddress = publicKeyToAddress(publicKey);

  let inputTotal = 0n;
  const seen = new Set();

  for (const input of tx.inputs) {
    const key = `${input.txId}:${input.index}`;

    if (seen.has(key)) {
      throw new Error('DUPLICATE_INPUT');
    }

    seen.add(key);

    if (!utxo.validateInput(input, publicKey)) {
      throw new Error('INVALID_UTXO_INPUT');
    }

    inputTotal += amount(
      utxo.get(input.txId, input.index).amount
    );
  }

  const outputTotal = tx.outputs.reduce(
    (sum, output) => sum + amount(output.amount),
    0n
  );

  const feeAmount = amount(tx.fee);

  if (outputTotal + feeAmount > inputTotal) {
    throw new Error('INSUFFICIENT_INPUT_VALUE');
  }

  if (!tx.outputs.some(o => o.address === senderAddress)) {
    // Allowed: sender may spend the complete balance elsewhere.
  }

  tx.publicKey = publicKey
    .export({
      type: 'spki',
      format: 'der'
    })
    .toString('base64');

  tx.id = transactionId(tx);

  tx.signature = signPayload(
    transactionPayload(tx),
    privateKey
  );

  return tx;
}

function verifySignedTransaction(tx) {
  try {
    if (!tx || !tx.publicKey || !tx.signature || !tx.id) {
      return false;
    }

    const publicKey = crypto.createPublicKey({
      key: Buffer.from(tx.publicKey, 'base64'),
      type: 'spki',
      format: 'der'
    });

    if (transactionId(tx) !== tx.id) {
      return false;
    }

    return verifyPayload(
      transactionPayload(tx),
      tx.signature,
      publicKey
    );
  } catch {
    return false;
  }
}

module.exports = {
  UTXOSet,
  createSignedTransaction,
  verifySignedTransaction,
  transactionId
};
