'use strict';

const {
  verifySignedTransaction
} = require('./utxo');

class Mempool {
  constructor(options = {}) {
    this.utxoSet = options.utxoSet || null;
    this.maxSize = Number.isInteger(options.maxSize)
      ? options.maxSize
      : 10000;

    this.transactions = new Map();
    this.reservedInputs = new Map();
    this.lastError = null;
  }

  _txId(tx) {
    return String(
      tx && (tx.id || tx.txId || tx.transactionId || '')
    ).trim();
  }

  _inputKey(input) {
    if (!input || typeof input !== 'object') {
      return null;
    }

    const txId =
      input.txId ??
      input.transactionId ??
      input.prevTxId ??
      input.prevHash;

    const index =
      input.outputIndex ??
      input.index ??
      input.vout;

    if (txId === undefined || index === undefined) {
      return null;
    }

    return `${String(txId)}:${String(index)}`;
  }

  _fee(tx) {
    try {
      return BigInt(tx.fee ?? 0);
    } catch {
      return -1n;
    }
  }

  _fail(code, message) {
    this.lastError = {
      code,
      message
    };

    return {
      valid: false,
      code,
      message
    };
  }

  _success() {
    this.lastError = null;

    return {
      valid: true,
      code: 'VALID'
    };
  }

  validateMempoolTransaction(tx) {
    if (!tx || typeof tx !== 'object') {
      return this._fail(
        'INVALID_TRANSACTION',
        'Transaction must be an object'
      );
    }

    if (tx.coinbase === true || tx.isCoinbase === true) {
      return this._fail(
        'COINBASE_NOT_ALLOWED',
        'Coinbase transaction cannot enter mempool'
      );
    }

    if (!Array.isArray(tx.inputs) || tx.inputs.length === 0) {
      return this._fail(
        'INVALID_INPUTS',
        'Transaction must contain inputs'
      );
    }

    if (!Array.isArray(tx.outputs) || tx.outputs.length === 0) {
      return this._fail(
        'INVALID_OUTPUTS',
        'Transaction must contain outputs'
      );
    }

    const txId = this._txId(tx);

    if (!txId) {
      return this._fail(
        'MISSING_TX_ID',
        'Transaction ID is required'
      );
    }

    if (this.transactions.has(txId)) {
      return this._fail(
        'DUPLICATE_TRANSACTION',
        `Transaction already exists: ${txId}`
      );
    }

    const fee = this._fee(tx);

    if (fee < 0n) {
      return this._fail(
        'INVALID_FEE',
        'Fee cannot be negative or invalid'
      );
    }

    if (typeof verifySignedTransaction !== 'function') {
      return this._fail(
        'SIGNATURE_VALIDATOR_UNAVAILABLE',
        'verifySignedTransaction is unavailable'
      );
    }

    try {
      const signatureValid = verifySignedTransaction(tx);

      if (!signatureValid) {
        return this._fail(
          'INVALID_SIGNATURE',
          'Transaction signature verification failed'
        );
      }
    } catch (error) {
      return this._fail(
        'INVALID_SIGNATURE',
        error && error.message
          ? error.message
          : 'Transaction signature verification failed'
      );
    }

    if (!this.utxoSet) {
      return this._fail(
        'UTXO_SET_UNAVAILABLE',
        'UTXO set is required for mempool validation'
      );
    }

    if (
      typeof this.utxoSet.validateInput !== 'function'
    ) {
      return this._fail(
        'UTXO_VALIDATOR_UNAVAILABLE',
        'UTXO validateInput() is unavailable'
      );
    }

    const seenInputs = new Set();

    for (const input of tx.inputs) {
      const key = this._inputKey(input);

      if (!key) {
        return this._fail(
          'INVALID_INPUT_REFERENCE',
          'Input does not contain a valid previous-output reference'
        );
      }

      if (seenInputs.has(key)) {
        return this._fail(
          'DOUBLE_SPEND_IN_TRANSACTION',
          `Duplicate input detected: ${key}`
        );
      }

      seenInputs.add(key);

      const reservedBy =
        this.reservedInputs.get(key);

      if (
        reservedBy &&
        reservedBy !== txId
      ) {
        return this._fail(
          'DOUBLE_SPEND_MEMPOOL',
          `Input already reserved by transaction ${reservedBy}`
        );
      }

      let validUTXO = false;

      try {
        validUTXO = Boolean(
          this.utxoSet.validateInput(
            input,
            tx.publicKey || input.publicKey
          )
        );
      } catch (error) {
        return this._fail(
          'INVALID_UTXO',
          error && error.message
            ? error.message
            : `UTXO validation failed: ${key}`
        );
      }

      if (!validUTXO) {
        return this._fail(
          'INVALID_UTXO',
          `UTXO validation failed: ${key}`
        );
      }
    }

    return this._success();
  }

  addToMempool(tx) {
    if (
      this.transactions.size >=
      this.maxSize
    ) {
      throw new Error('MEMPOOL_FULL');
    }

    const result =
      this.validateMempoolTransaction(tx);

    if (!result.valid) {
      throw new Error(
        `${result.code}: ${result.message}`
      );
    }

    const txId = this._txId(tx);

    if (!txId) {
      throw new Error(
        'MISSING_TX_ID: Transaction ID is required'
      );
    }

    this.transactions.set(
      txId,
      tx
    );

    for (const input of tx.inputs) {
      const key = this._inputKey(input);

      if (key) {
        this.reservedInputs.set(
          key,
          txId
        );
      }
    }

    this.lastError = null;

    return tx;
  }

  removeFromMempool(tx) {
    const txId =
      typeof tx === 'string'
        ? tx
        : this._txId(tx);

    if (!txId) {
      return false;
    }

    const stored =
      this.transactions.get(txId);

    if (!stored) {
      return false;
    }

    for (
      const input of
      stored.inputs || []
    ) {
      const key =
        this._inputKey(input);

      if (
        key &&
        this.reservedInputs.get(key) ===
          txId
      ) {
        this.reservedInputs.delete(key);
      }
    }

    this.transactions.delete(txId);
    this.lastError = null;

    return true;
  }

  getMempool() {
    return Array.from(
      this.transactions.values()
    ).sort((a, b) => {
      const feeA = this._fee(a);
      const feeB = this._fee(b);

      if (feeA !== feeB) {
        return feeA > feeB ? -1 : 1;
      }

      return this._txId(a)
        .localeCompare(this._txId(b));
    });
  }

  hasTransaction(txId) {
    return this.transactions.has(
      String(txId)
    );
  }

  getMempoolSize() {
    return this.transactions.size;
  }

  size() {
    return this.transactions.size;
  }

  clear() {
    this.transactions.clear();
    this.reservedInputs.clear();
    this.lastError = null;
  }

  getStatus() {
    return {
      size: this.transactions.size,
      maxSize: this.maxSize,
      reservedInputs:
        this.reservedInputs.size,
      transactionIds:
        this.getMempool().map(
          tx => this._txId(tx)
        )
    };
  }
}

function createMempool(options) {
  return new Mempool(options);
}

module.exports = {
  Mempool,
  createMempool
};

