<script>
const API = location.protocol + '//' + location.hostname + ':8787';

async function getJSON(path){
  const response = await fetch(API + path, {
    cache:'no-store'
  });

  if(!response.ok){
    throw new Error('HTTP ' + response.status);
  }

  return response.json();
}

async function refreshHealth(){
  try{
    const data = await getJSON('/health');

    document.getElementById('network-status').textContent =
      'Backend فعال';

    document.getElementById('side-status').textContent =
      'Online';

    document.getElementById('node-id').textContent =
      data.node_id || '--';

    document.getElementById('peer-count').textContent =
      data.peers ?? '--';

    document.getElementById('p2p-peers').textContent =
      data.peers ?? '--';

    document.getElementById('api-state').textContent =
      'ONLINE';

    document.getElementById('p2p-status').textContent =
      'ONLINE';

  }catch(error){

    document.getElementById('network-status').textContent =
      'Backend قطع است';

    document.getElementById('side-status').textContent =
      'Offline';

    document.getElementById('api-state').textContent =
      'OFFLINE';

    document.getElementById('p2p-status').textContent =
      'OFFLINE';
  }
}

async function refreshPeers(){
  try{
    const data = await getJSON('/api/peers');

    document.getElementById('p2p-peers').textContent =
      data.peers_count ?? '--';

    document.getElementById('peer-count').textContent =
      data.peers_count ?? '--';

    showNotice(
      'Peerهای واقعی مشاهده‌شده: ' +
      (data.peers_count ?? 0)
    );

  }catch(error){
    showNotice('دریافت وضعیت P2P شکست خورد.');
  }
}

async function refreshStats(){
  try{
    const data = await getJSON('/api/stats');

    document.getElementById('uptime').textContent =
      Math.floor(data.uptime_seconds || 0) + 's';

  }catch(error){}
}

async function refreshAll(){
  await Promise.all([
    refreshHealth(),
    refreshPeers(),
    refreshStats()
  ]);
}

function showNotice(message){
  alert(message);
}

function navigate(section){

  const target = document.getElementById(section);

  if(target){
    target.scrollIntoView({
      behavior:'smooth',
      block:'start'
    });
  }

  document.querySelectorAll('[data-section]').forEach(button=>{
    button.classList.toggle(
      'active',
      button.dataset.section === section
    );
  });

  const names = {
    home:'داشبورد جهانی',
    wallet:'کیف پول',
    market:'صرافی GDM',
    industry:'بازارها',
    p2p:'شبکه P2P',
    ai:'هوش مصنوعی',
    social:'شبکه اجتماعی',
    ads:'تبلیغات',
    settings:'تنظیمات'
  };

  document.getElementById('page-title').textContent =
    names[section] || 'داشبورد جهانی';
}

document.querySelectorAll('[data-section]').forEach(button=>{
  button.addEventListener('click',()=>{
    navigate(button.dataset.section);
  });
});

refreshAll();

setInterval(refreshHealth,5000);
setInterval(refreshStats,5000);


// ═══════════════════════════════════════════════════════
// ⛓️ Blockchain Dashboard
// ═══════════════════════════════════════════════════════

async function refreshChain() {
  try {
    const r = await fetch('/api/chain/stats');
    const d = await r.json();
    if (!d.ok) throw new Error('API error');
    
    const setEl = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };
    
    setEl('chain-length', d.length);
    setEl('chain-difficulty', d.difficulty);
    setEl('chain-valid', d.is_valid ? '✅' : '❌');
    setEl('chain-pending', d.pending_tx);
    setEl('chain-supply', (d.total_supply / 1000000).toFixed(2) + 'M');
    setEl('chain-wallets', d.wallets_count || 0);
    
    const hashEl = document.getElementById('chain-latest-hash');
    if (hashEl) hashEl.textContent = d.latest_hash;
    
    // بارگذاری بلاک‌ها
    const r2 = await fetch('/api/chain');
    const d2 = await r2.json();
    if (d2.ok && d2.chain) {
      const preview = document.getElementById('blocks-preview');
      if (preview) {
        const blocks = d2.chain.slice(-5).reverse();
        preview.innerHTML = blocks.map(b => `
          <div class="block-preview-item">
            <span class="block-idx">#${b.index}</span>
            <span class="block-hash">${b.hash.substring(0, 20)}...</span>
            <span class="block-tx">${b.tx_count} tx</span>
          </div>
        `).join('');
      }
    }
  } catch(e) {
    console.error('Chain refresh error:', e);
  }
}

async function mineBlockFromDashboard() {
  try {
    const btn = event.target;
    btn.disabled = true;
    btn.textContent = '⛏️ در حال استخراج...';
    
    const r = await fetch('/api/chain/mine', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ miner: 'GDM-dashboard-miner' })
    });
    const d = await r.json();
    
    if (d.ok) {
      alert('🎉 بلوک #' + d.block.index + ' استخراج شد!');
      await refreshChain();
    } else {
      alert('❌ خطا: ' + d.error);
    }
  } catch(e) {
    alert('❌ خطا در استخراج');
  } finally {
    const btn = event.target;
    btn.disabled = false;
    btn.textContent = '⛏️ استخراج بلوک جدید';
  }
}

// شروع خودکار
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(refreshChain, 1000);
  setInterval(refreshChain, 10000);
});


// ═══════════════════════════════════════════════════════
// 💱 Exchange JavaScript
// ═══════════════════════════════════════════════════════

async function refreshExchange() {
  try {
    // Order Book
    const r1 = await fetch('/api/exchange/orderbook');
    const d1 = await r1.json();
    
    if (d1.ok) {
      const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
      
      set('ex-last-price', (d1.lastPrice || 0).toLocaleString());
      
      // Bids
      const bidsEl = document.getElementById('ex-bids');
      if (bidsEl) {
        if (d1.bids && d1.bids.length > 0) {
          bidsEl.innerHTML = d1.bids.map(b => 
            `<div style="display:flex;justify-content:space-between;padding:6px;border-bottom:1px solid #1a2332;">
              <span style="color:#4ade80;">${b.price.toLocaleString()}</span>
              <span style="color:#8ba3c7;">${b.amount}</span>
              <span style="color:#ffd700;">${b.total.toLocaleString()}</span>
            </div>`
          ).join('');
        } else {
          bidsEl.innerHTML = '<div style="color:#8ba3c7;text-align:center;padding:20px;">هیچ سفارش خریدی نیست</div>';
        }
      }
      
      // Asks
      const asksEl = document.getElementById('ex-asks');
      if (asksEl) {
        if (d1.asks && d1.asks.length > 0) {
          asksEl.innerHTML = d1.asks.map(a => 
            `<div style="display:flex;justify-content:space-between;padding:6px;border-bottom:1px solid #1a2332;">
              <span style="color:#f87171;">${a.price.toLocaleString()}</span>
              <span style="color:#8ba3c7;">${a.amount}</span>
              <span style="color:#ffd700;">${a.total.toLocaleString()}</span>
            </div>`
          ).join('');
        } else {
          asksEl.innerHTML = '<div style="color:#8ba3c7;text-align:center;padding:20px;">هیچ سفارش فروشی نیست</div>';
        }
      }
    }
    
    // Stats 24h
    const r2 = await fetch('/api/exchange/stats24h');
    const d2 = await r2.json();
    
    if (d2.ok) {
      const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
      set('ex-volume', (d2.volume || 0).toLocaleString());
      set('ex-high', (d2.high || 0).toLocaleString());
      set('ex-low', (d2.low || 0).toLocaleString());
      set('ex-trades', d2.trades || 0);
    }
    
    // Global Stats
    const r3 = await fetch('/api/exchange/stats');
    const d3 = await r3.json();
    
    if (d3.ok) {
      const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
      set('ex-orders', d3.open_orders || 0);
    }
    
    // سفارش‌های من
    const userId = document.getElementById('ex-user')?.value;
    if (userId) {
      const r4 = await fetch('/api/exchange/orders?user=' + userId);
      const d4 = await r4.json();
      
      const myEl = document.getElementById('ex-my-orders');
      if (myEl && d4.ok && d4.orders) {
        if (d4.orders.length === 0) {
          myEl.innerHTML = '<div style="color:#8ba3c7;text-align:center;">هیچ سفارشی نداری</div>';
        } else {
          myEl.innerHTML = d4.orders.map(o => 
            `<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:10px;background:#0a0e17;border-radius:8px;margin-bottom:8px;font-size:12px;">
              <span style="color:${o.side === 'BUY' ? '#4ade80' : '#f87171'};">${o.side === 'BUY' ? '🟢 خرید' : '🔴 فروش'}</span>
              <span style="color:#ffd700;">${o.price.toLocaleString()}</span>
              <span style="color:#8ba3c7;">${o.remaining}/${o.amount}</span>
              <span style="color:${o.status === 'FILLED' ? '#4ade80' : o.status === 'OPEN' ? '#ffd700' : '#f87171'};">${o.status}</span>
              <button onclick="cancelOrder('${o.orderId}','${o.userId}')" style="background:#f87171;color:#fff;border:none;border-radius:4px;padding:4px;cursor:pointer;">لغو</button>
            </div>`
          ).join('');
        }
      }
    }
  } catch(e) {
    console.error('Exchange error:', e);
  }
}

async function placeOrder() {
  const side = document.getElementById('ex-side')?.value;
  const price = parseInt(document.getElementById('ex-price')?.value);
  const amount = parseInt(document.getElementById('ex-amount')?.value);
  const userId = document.getElementById('ex-user')?.value;
  
  if (!side || !price || !amount || !userId) {
    alert('❌ همه فیلدها رو پر کن');
    return;
  }
  
  try {
    const r = await fetch('/api/exchange/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId, side, price, amount })
    });
    const d = await r.json();
    
    if (d.ok) {
      const msg = d.message === 'ORDER_MATCHED' 
        ? '🎉 سفارش ثبت و معامله انجام شد!' 
        : '✅ سفارش با موفقیت ثبت شد';
      alert(msg);
      await refreshExchange();
    } else {
      alert('❌ خطا: ' + (d.error || 'unknown'));
    }
  } catch(e) {
    alert('❌ خطا در ارتباط');
  }
}

async function cancelOrder(orderId, userId) {
  if (!confirm('لغو سفارش ' + orderId + '؟')) return;
  
  try {
    const r = await fetch('/api/exchange/cancel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderId, userId })
    });
    const d = await r.json();
    
    if (d.ok) {
      alert('✅ سفارش لغو شد');
      await refreshExchange();
    } else {
      alert('❌ خطا: ' + (d.error || ''));
    }
  } catch(e) {
    alert('❌ خطا');
  }
}

// بروزرسانی خودکار
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(refreshExchange, 2000);
  setInterval(refreshExchange, 15000);
});
