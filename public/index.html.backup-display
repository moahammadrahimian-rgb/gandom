<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07100d">
<title>GANDOM — Global Decentralized Network</title>

<style>
:root{
  --bg:#050908;
  --panel:#0b1210;
  --panel2:#101a16;
  --line:#24342d;
  --gold:#d6a84f;
  --gold2:#f0cf78;
  --green:#55c878;
  --text:#edf3ee;
  --muted:#8e9b94;
  --red:#e66b6b;
  --blue:#55aee8;
  --purple:#9c7bea;
  --shadow:0 18px 50px rgba(0,0,0,.38);
}

*{box-sizing:border-box}

body{
  margin:0;
  background:
    radial-gradient(circle at 80% 0%,rgba(214,168,79,.09),transparent 30%),
    radial-gradient(circle at 10% 30%,rgba(85,200,120,.06),transparent 28%),
    var(--bg);
  color:var(--text);
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,sans-serif;
}

button{
  font:inherit;
  cursor:pointer;
}

.app{
  min-height:100vh;
  display:grid;
  grid-template-columns:250px 1fr;
}

.sidebar{
  position:sticky;
  top:0;
  height:100vh;
  padding:22px 16px;
  background:rgba(7,12,10,.94);
  border-left:1px solid var(--line);
  backdrop-filter:blur(18px);
  z-index:10;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  padding:8px 6px 24px;
}

.wheat{
  width:46px;
  height:46px;
  border-radius:15px;
  display:grid;
  place-items:center;
  background:linear-gradient(145deg,#f2ce72,#9b7027);
  color:#10120d;
  font-size:25px;
  box-shadow:0 0 30px rgba(214,168,79,.25);
}

.brand strong{
  display:block;
  font-size:24px;
  letter-spacing:2px;
}

.brand small{
  color:var(--muted);
  font-size:9px;
  letter-spacing:1.5px;
}

.nav{
  display:grid;
  gap:7px;
}

.nav button{
  border:1px solid transparent;
  color:#b8c2bc;
  background:transparent;
  text-align:right;
  padding:12px 14px;
  border-radius:12px;
  transition:.2s;
}

.nav button:hover,
.nav button.active{
  color:var(--gold2);
  background:rgba(214,168,79,.08);
  border-color:rgba(214,168,79,.25);
}

.network-mini{
  margin-top:25px;
  padding:15px;
  border:1px solid var(--line);
  border-radius:16px;
  background:var(--panel);
}

.dot{
  display:inline-block;
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--green);
  box-shadow:0 0 12px var(--green);
  margin-left:7px;
}

.main{
  min-width:0;
  padding:18px;
}

.header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  margin-bottom:18px;
  padding:16px 20px;
  border:1px solid var(--line);
  border-radius:20px;
  background:rgba(11,18,16,.8);
  box-shadow:var(--shadow);
}

.status{
  color:var(--muted);
  font-size:13px;
}

.actions{
  display:flex;
  gap:8px;
}

.icon-btn{
  width:40px;
  height:40px;
  border:1px solid var(--line);
  background:var(--panel2);
  color:var(--text);
  border-radius:12px;
}

.hero{
  display:grid;
  grid-template-columns:1.5fr .8fr;
  gap:16px;
  margin-bottom:16px;
}

.card{
  background:linear-gradient(145deg,rgba(16,26,22,.96),rgba(8,14,12,.96));
  border:1px solid var(--line);
  border-radius:20px;
  box-shadow:var(--shadow);
}

.hero-main{
  min-height:235px;
  padding:28px;
  position:relative;
  overflow:hidden;
}

.hero-main:after{
  content:"";
  position:absolute;
  width:260px;
  height:260px;
  border-radius:50%;
  left:-80px;
  bottom:-150px;
  border:1px solid rgba(214,168,79,.22);
  box-shadow:0 0 80px rgba(214,168,79,.08);
}

.eyebrow{
  color:var(--gold2);
  font-size:12px;
  letter-spacing:2px;
}

.hero h1{
  margin:12px 0 5px;
  font-size:clamp(34px,5vw,64px);
  letter-spacing:3px;
}

.hero p{
  color:var(--muted);
  max-width:650px;
  line-height:1.9;
}

.hero-owner{
  padding:25px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.owner-value{
  font-size:28px;
  margin:12px 0;
  color:var(--gold2);
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

.module{
  padding:18px;
  min-height:190px;
}

.module-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.module h3{
  margin:0;
  font-size:18px;
}

.badge{
  font-size:11px;
  padding:5px 9px;
  border-radius:999px;
  background:#142019;
  color:var(--green);
  border:1px solid rgba(85,200,120,.2);
}

.metric{
  font-size:26px;
  font-weight:700;
  margin:12px 0;
}

.muted{
  color:var(--muted);
}

.small{
  font-size:12px;
}

.primary{
  width:100%;
  margin-top:15px;
  padding:11px;
  border-radius:11px;
  border:1px solid rgba(214,168,79,.35);
  background:rgba(214,168,79,.1);
  color:var(--gold2);
}

.primary:hover{
  background:rgba(214,168,79,.18);
}

.market{
  margin-top:16px;
  padding:20px;
}

.market-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
}

.market-title{
  display:flex;
  align-items:center;
  gap:10px;
}

.price{
  font-size:30px;
  font-weight:800;
  color:var(--gold2);
}

.market-body{
  display:grid;
  grid-template-columns:1.4fr .7fr;
  gap:16px;
  margin-top:18px;
}

.chart{
  min-height:260px;
  position:relative;
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:15px;
  background:
    linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
  background-size:40px 40px;
}

.chart-note{
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
  color:var(--muted);
}

.order-box{
  border:1px solid var(--line);
  border-radius:15px;
  padding:16px;
}

.tabs{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
}

.tab{
  border:1px solid var(--line);
  background:transparent;
  color:var(--muted);
  padding:8px 12px;
  border-radius:9px;
}

.tab.active{
  color:var(--gold2);
  border-color:rgba(214,168,79,.4);
}

.industry{
  margin-top:16px;
}

.industry-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-top:12px;
}

.industry-card{
  padding:18px;
  min-height:125px;
}

.industry-icon{
  font-size:25px;
  margin-bottom:8px;
}

.footer{
  margin:18px 0 75px;
  text-align:center;
  color:#6f7c75;
  font-size:11px;
}

.mobile-nav{
  display:none;
}

@media(max-width:1100px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .industry-grid{grid-template-columns:repeat(2,1fr)}
  .hero{grid-template-columns:1fr}
}

@media(max-width:760px){
  .app{display:block}
  .sidebar{
    display:none;
  }

  .main{
    padding:10px;
  }

  .header{
    padding:12px;
    border-radius:15px;
  }

  .header .status{
    display:none;
  }

  .hero-main{
    min-height:205px;
    padding:22px;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .market-body{
    grid-template-columns:1fr;
  }

  .industry-grid{
    grid-template-columns:1fr 1fr;
  }

  .mobile-nav{
    position:fixed;
    display:grid;
    grid-template-columns:repeat(5,1fr);
    bottom:8px;
    right:8px;
    left:8px;
    padding:7px;
    border:1px solid var(--line);
    border-radius:17px;
    background:rgba(7,12,10,.96);
    backdrop-filter:blur(18px);
    z-index:30;
  }

  .mobile-nav button{
    border:0;
    background:transparent;
    color:var(--muted);
    padding:9px 3px;
    font-size:11px;
  }

  .mobile-nav button.active{
    color:var(--gold2);
  }
}


/* ═══════ Blockchain Styles ═══════ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 15px;
  margin: 20px 0;
}

.stat-card {
  background: linear-gradient(135deg, #1a2332 0%, #0f1620 100%);
  border: 1px solid #2a3f5f;
  border-radius: 12px;
  padding: 18px;
  text-align: center;
  transition: all 0.3s;
}

.stat-card:hover {
  border-color: #ffd700;
  transform: translateY(-3px);
}

.stat-icon {
  font-size: 28px;
  margin-bottom: 8px;
}

.stat-value {
  color: #ffd700;
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 4px;
}

.stat-label {
  color: #8ba3c7;
  font-size: 12px;
}

.chain-hash-box {
  background: #0a0e17;
  border: 1px solid #2a3f5f;
  border-radius: 10px;
  padding: 15px;
  margin: 20px 0;
}

.hash-label {
  color: #8ba3c7;
  font-size: 12px;
  margin-bottom: 5px;
}

.hash-value {
  color: #4ade80;
  font-family: monospace;
  font-size: 12px;
  word-break: break-all;
}

.chain-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin: 20px 0;
}

.action-btn {
  padding: 12px 24px;
  background: #ffd700;
  color: #000;
  border: none;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
  text-decoration: none;
  font-size: 14px;
  font-family: inherit;
  transition: all 0.3s;
}

.action-btn:hover {
  background: #e5c100;
  transform: translateY(-2px);
}

.action-btn.secondary {
  background: #2a3f5f;
  color: #ffd700;
  border: 1px solid #ffd700;
}

.action-btn.secondary:hover {
  background: #3a5070;
}

.action-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.chain-blocks-preview {
  background: #1a2332;
  border: 1px solid #2a3f5f;
  border-radius: 12px;
  padding: 20px;
  margin-top: 20px;
}

.chain-blocks-preview h3 {
  color: #ffd700;
  margin-bottom: 15px;
}

.block-preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #0a0e17;
  padding: 10px 15px;
  border-radius: 8px;
  margin-bottom: 8px;
  font-size: 13px;
  font-family: monospace;
}

.block-idx {
  color: #ffd700;
  font-weight: bold;
}

.block-hash {
  color: #4ade80;
  flex: 1;
  margin: 0 15px;
}

.block-tx {
  color: #8ba3c7;
}
</style>
</head>

<body>

<div class="app">

<aside class="sidebar">

  <div class="brand">
    <div class="wheat">🌾</div>
    <div>
      <strong>GANDOM</strong>
      <small>GLOBAL DECENTRALIZED NETWORK</small>
    </div>
  </div>

  <nav class="nav">
    <button class="active" data-section="home">⌂ خانه</button>
    <button data-section="wallet">▣ کیف پول</button>
    <button data-section="market">◈ صرافی GDM</button>
    <button data-section="industry">◉ اصناف و بازارها</button>
    <button data-section="p2p">⌘ P2P</button>
    <button data-section="ai">✦ هوش مصنوعی</button>
    <button data-section="social">◎ شبکه اجتماعی</button>
    <button data-section="ads">◇ تبلیغات</button>
    <button data-section="settings">⚙ تنظیمات</button>
        <button data-section="exchange" class="nav-btn">
          <span class="nav-icon">💱</span>
          <span class="nav-label">صرافی</span>
        </button>
        <button data-section="blockchain" class="nav-btn">
          <span class="nav-icon">⛓️</span>
          <span class="nav-label">بلاک‌چین</span>
        </button>
  </nav>

  <div class="network-mini">
    <div><span class="dot"></span>شبکه GANDOM</div>
    <div class="muted small" style="margin-top:8px">
      وضعیت: <span id="side-status">در حال بررسی</span>
    </div>
  </div>

</aside>

<main class="main">

<header class="header">

  <div>
    <div class="eyebrow">GANDOM NETWORK</div>
    <div id="page-title">داشبورد جهانی</div>
  </div>

  <div class="status">
    <span class="dot"></span>
    <span id="network-status">در حال بررسی شبکه...</span>
  </div>

  <div class="actions">
    <button class="icon-btn" onclick="refreshAll()">↻</button>
    <button class="icon-btn" onclick="showNotice('تنظیمات امنیتی در حال اتصال به API است.')">⚙</button>
  </div>

</header>

<section class="hero">

  <div class="card hero-main">
    <div class="eyebrow">GLOBAL DECENTRALIZED ECONOMY</div>
    <h1>GANDOM</h1>
    <p>
      یک رابط واحد برای شبکه P2P، اقتصاد دیجیتال،
      بازارهای واقعی، هوش مصنوعی و خدمات غیرمتمرکز.
    </p>
    <div class="muted small">
      اجرای واقعی فقط پس از تأیید Backend و شبکه ثبت می‌شود.
    </div>
  </div>

  <div class="card hero-owner">
    <div class="muted small">وضعیت Node</div>
    <div class="owner-value" id="node-id">در انتظار API</div>
    <div class="muted small">
      Peers:
      <span id="peer-count">--</span>
    </div>
  </div>

</section>

<section class="grid">

  <article class="card module" id="p2p">
    <div class="module-head">
      <h3>⌘ هسته P2P</h3>
      <span class="badge" id="p2p-status">CHECK</span>
    </div>
    <div class="metric" id="p2p-peers">--</div>
    <div class="muted">Peerهای مشاهده‌شده</div>
    <button class="primary" onclick="refreshPeers()">بررسی واقعی شبکه</button>
  </article>

  <article class="card module" id="ai">
    <div class="module-head">
      <h3>✦ AI Core</h3>
      <span class="badge">CORE</span>
    </div>
    <div class="metric">READY</div>
    <div class="muted">تحلیل، تصمیم‌یار و اتوماسیون</div>
    <button class="primary" onclick="showNotice('AI فقط پس از اتصال سرویس واقعی فعال می‌شود.')">
      ورود به AI
    </button>
  </article>

  <article class="card module" id="wallet">
    <div class="module-head">
      <h3>▣ کیف پول</h3>
      <span class="badge">SECURE</span>
    </div>
    <div class="metric">-- GDM</div>
    <div class="muted">موجودی پس از اتصال Wallet API</div>
    <button class="primary" onclick="showNotice('تراکنش مالی بدون API واقعی اجرا نمی‌شود.')">
      ورود به کیف پول
    </button>
  </article>

  <article class="card module" id="social">
    <div class="module-head">
      <h3>◎ شبکه اجتماعی</h3>
      <span class="badge">SOCIAL</span>
    </div>
    <div class="metric">GANDOM</div>
    <div class="muted">محتوا، ارتباط و اقتصاد اجتماعی</div>
    <button class="primary" onclick="showNotice('ماژول Social API در حال اتصال است.')">
      ورود به شبکه
    </button>
  </article>

</section>

<section class="card market" id="market">

  <div class="market-top">

    <div class="market-title">
      <h2 style="margin:0">صرافی GDM</h2>
      <span class="badge">GDM / USDT</span>
    </div>

    <div class="tabs">
      <button class="tab active">نمودار</button>
      <button class="tab" onclick="showNotice('خرید فقط با Trading API واقعی فعال می‌شود.')">خرید</button>
      <button class="tab" onclick="showNotice('فروش فقط با Trading API واقعی فعال می‌شود.')">فروش</button>
      <button class="tab" onclick="showNotice('Deposit API هنوز متصل نیست.')">واریز</button>
      <button class="tab" onclick="showNotice('Withdraw API هنوز متصل نیست.')">برداشت</button>
      <button class="tab">تاریخچه</button>
    </div>

  </div>

  <div style="margin-top:16px">
    <div class="muted small">قیمت زنده GDM</div>
    <div class="price">--</div>
    <div class="muted small">
      قیمت تا اتصال Market API عمداً نمایش داده نمی‌شود.
    </div>
  </div>

  <div class="market-body">

    <div class="chart">
      <div class="chart-note">
        نمودار پس از اتصال دادهٔ واقعی بازار فعال می‌شود
      </div>
    </div>

    <div class="order-box">
      <h3>سفارش</h3>

      <div class="muted small">
        خرید / فروش فقط از مسیر API معتبر انجام می‌شود.
      </div>

      <button class="primary"
        onclick="showNotice('Trading API هنوز برای اجرای تراکنش متصل نشده است.')">
        اتصال بازار
      </button>

    </div>

  </div>

</section>

<section class="industry">

  <div class="card module-head" style="padding:18px;margin:0">
    <h3>بازارهای واقعی و اصناف</h3>
    <span class="badge">GLOBAL MARKET</span>
  </div>

  <div class="industry-grid">

    <article class="card industry-card">
      <div class="industry-icon">🥇</div>
      <strong>طلا و جواهر</strong>
      <div class="muted small">بازار طلا، جواهر و دارایی</div>
      <button class="primary" onclick="showNotice('Market API طلا هنوز متصل نیست.')">ورود</button>
    </article>

    <article class="card industry-card">
      <div class="industry-icon">🏠</div>
      <strong>املاک</strong>
      <div class="muted small">خرید، فروش و خدمات املاک</div>
      <button class="primary" onclick="showNotice('Real Estate API هنوز متصل نیست.')">ورود</button>
    </article>

    <article class="card industry-card">
      <div class="industry-icon">🚗</div>
      <strong>خودرو</strong>
      <div class="muted small">بازار خودرو و خدمات وابسته</div>
      <button class="primary" onclick="showNotice('Auto API هنوز متصل نیست.')">ورود</button>
    </article>

    <article class="card industry-card">
      <div class="industry-icon">⚙</div>
      <strong>مس / نقره / فلزات</strong>
      <div class="muted small">بازار فلزات و کالا</div>
      <button class="primary" onclick="showNotice('Metals API هنوز متصل نیست.')">ورود</button>
    </article>

  </div>

</section>

<section class="grid" style="margin-top:16px">

  <article class="card module" id="ads">
    <div class="module-head">
      <h3>◇ تبلیغات هوشمند</h3>
      <span class="badge">AI ADS</span>
    </div>
    <div class="metric">READY</div>
    <div class="muted">درآمد تبلیغات فقط از رویداد واقعی</div>
  </article>

  <article class="card module">
    <div class="module-head">
      <h3>🛡 امنیت</h3>
      <span class="badge">2558</span>
    </div>
    <div class="metric">ACTIVE</div>
    <div class="muted">Gateهای حاکمیتی و شواهد اجرایی</div>
  </article>

  <article class="card module" id="settings">
    <div class="module-head">
      <h3>⚙ تنظیمات</h3>
      <span class="badge">SYSTEM</span>
    </div>
    <div class="metric" id="api-state">CHECK</div>
    <div class="muted">Backend API</div>
  </article>
    <!-- ═══════ Exchange Section ═══════ -->
    <section class="card exchange-module" id="exchange" style="display:none; margin-top:16px;">
      <div class="module-head">
        <h3>💱 صرافی GDM/IRT</h3>
        <span class="badge">EXCHANGE</span>
      </div>
      
      <!-- آمار -->
      <div class="stats-grid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; margin:20px 0;">
