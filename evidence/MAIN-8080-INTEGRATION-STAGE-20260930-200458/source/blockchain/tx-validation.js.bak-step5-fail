'use strict';

const crypto = require('crypto');

const { UTXOSet, verifySignedTransaction } = require('./utxo');

const MAX_INPUTS = 256;
const MAX_OUTPUTS = 256;
const MAX_AMOUNT = (1n << 120n) - 1n;

function amount(v) {
  if (typeof v !== 'string' && typeof v !== 'number' && typeof v !== 'bigint')
    throw new Error('INVALID_AMOUNT');

  const s = String(v);
  if (!/^[1-9][0-9]*$/.test(s))
    throw new Error('INVALID_AMOUNT');

  const n = BigInt(s);
  if (n <= 0n || n > MAX_AMOUNT)
    throw new Error('INVALID_AMOUNT');

  return n;
}

function parseAmount(value) {
  try {
    const s = String(value);
    if (!/^\d+$/.test(s)) throw new Error('INVALID_AMOUNT');
    const n = BigInt(s);
    if (n < 0n) throw new Error('INVALID_AMOUNT');
    return n;
  } catch {
    throw new Error('INVALID_AMOUNT');
  }
}

function validateTransaction(tx, utxo, options = {}) {
  try {
    if (!tx || typeof tx !== 'object')
      throw new Error('INVALID_TRANSACTION');

    if (!Array.isArray(tx.inputs) || !Array.isArray(tx.outputs))
      throw new Error('INVALID_TRANSACTION');

    if (!(utxo instanceof UTXOSet))
      throw new Error('INVALID_UTXO_SET');

    if (!tx.inputs.length || !tx.outputs.length)
      throw new Error('EMPTY_TRANSACTION');

    if (tx.inputs.length > MAX_INPUTS)
      throw new Error('TOO_MANY_INPUTS');

    if (tx.outputs.length > MAX_OUTPUTS)
      throw new Error('TOO_MANY_OUTPUTS');

    if (!verifySignedTransaction(tx))
      throw new Error('INVALID_SIGNATURE');

    const seen = new Set();
    let inputTotal = 0n;

    for (const input of tx.inputs) {
      if (
        !input ||
        typeof input.txId !== 'string' ||
        !input.txId ||
        !Number.isInteger(input.index) ||
        input.index < 0
      ) {
        throw new Error('INVALID_INPUT');
      }

      const key = input.txId + ':' + input.index;

      if (seen.has(key))
        throw new Error('DUPLICATE_INPUT');

      seen.add(key);

      const output = utxo.get(input.txId, input.index);

      if (!output)
        throw new Error('UTXO_NOT_FOUND');

      if (utxo.isSpent(input.txId, input.index))
        throw new Error('DOUBLE_SPEND');

      const publicKey = crypto.createPublicKey({
      key: Buffer.from(tx.publicKey, 'base64'),
      type: 'spki',
      format: 'der'
    });

      if (!utxo.validateInput(input, publicKey))
        throw new Error('UTXO_OWNER_INVALID');

      inputTotal += amount(output.amount);
    }

    let outputTotal = 0n;

    for (const output of tx.outputs) {
      if (
        !output ||
        typeof output.address !== 'string' ||
        !/^[0-9a-f]{64}$/i.test(output.address)
      ) {
        throw new Error('INVALID_OUTPUT_ADDRESS');
      }

      outputTotal += amount(output.amount);
    }

    if (outputTotal > inputTotal)
      throw new Error('OUTPUTS_EXCEED_INPUTS');

    const fee = inputTotal - outputTotal;

    if (tx.fee !== undefined && amount(tx.fee) !== fee)
      throw new Error('FEE_MISMATCH');

    if (options.requireZeroFee && fee !== 0n)
      throw new Error('FEE_NOT_ALLOWED');

    return {
      valid: true,
      inputTotal: inputTotal.toString(),
      outputTotal: outputTotal.toString(),
      fee: fee.toString()
    };
  } catch (e) {
    return {
      valid: false,
      error: e.message
    };
  }
}

function assertValidTransaction(tx, utxo, options = {}) {
  const result = validateTransaction(tx, utxo, options);

  if (!result.valid)
    throw new Error(result.error);

  return result;
}

module.exports = {
  validateTransaction,
  assertValidTransaction,
  MAX_INPUTS,
  MAX_OUTPUTS
};
